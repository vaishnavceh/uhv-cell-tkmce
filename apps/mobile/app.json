{
  "expo": {
    "name": "UHV Ticket Scanner",
    "slug": "uhv-ticket-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#022c22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uhvcell.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan attendee ticket QR codes at event venue gates."
      }
    },
    "android": {
      "package": "com.uhvcell.scanner",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#022c22"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UHV Scanner to use your camera to scan ticket QR codes."
        }
      ]
    ]
  }
}
