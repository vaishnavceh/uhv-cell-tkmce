# ==============================================================================
# UNIVERSAL HUMAN VALUES (UHV) CELL - TKM COLLEGE OF ENGINEERING
# Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
POSTGRES_USER=uhv_user
POSTGRES_PASSWORD=uhv_secure_pass_2026
POSTGRES_DB=uhv_db
DATABASE_URL=postgresql://uhv_user:uhv_secure_pass_2026@postgres:5432/uhv_db?schema=public

# Cache & Performance (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Authentication (JWT)
# WARNING: Generate strong random secrets for production deployments!
JWT_ACCESS_SECRET=uhv_jwt_access_secret_key_random_long_string_tkmce_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=uhv_jwt_refresh_secret_key_random_long_string_tkmce_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# File Storage Abstraction (local | s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE=26214400

# S3 Compatible Object Storage Configuration (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=uhv-cell-tkmce
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Initial Administrator Provisioning (Development only)
# IMPORTANT: Change password immediately upon first deployment!
ADMIN_EMAIL=admin@tkmce.ac.in
ADMIN_PASSWORD=UHV_Tkmce@2026

# Frontend Build Variables
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE="Universal Human Values Cell - TKMCE"
